<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The disc, NKit and WBFS logic both applications share: the desktop app through GameFerry.Core, the web app
    compiled to WebAssembly. Nothing here may touch files, processes or Windows; the browser entry below makes the
    platform analyzer flag anything the browser runtime lacks.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GameFerry.Engine</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Building with -p:GameFerryBuiltInKeys=false leaves the Wii common keys out; users then supply their own. -->
  <PropertyGroup Condition="'$(GameFerryBuiltInKeys)' == 'false'">
    <DefineConstants>$(DefineConstants);NO_BUILTIN_KEYS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="GameFerry.Core" />
    <InternalsVisibleTo Include="GameFerry.Tests" />
  </ItemGroup>

</Project>
