<Window x:Class="GameFerry.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GameFerry.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings"
        Width="780" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,6,20,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" Padding="22,7" />
            <Button Content="Cancel" IsCancel="True" Padding="22,7" Margin="8,0,0,0" />
        </StackPanel>

        <!-- The settings scroll if the screen is too short to show them all; Save and Cancel stay put. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="NKit folder" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NKitFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseNKitFolderCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding NKitStatus}" Style="{StaticResource FieldHint}" />

                <TextBlock Text="Work folder" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding WorkFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseWorkFolderCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Each game is unpacked and rebuilt to a full ISO here before it is copied, then deleted. Use a local drive with at least 16 GB free (24 GB when preparing the next game ahead)." />

                <TextBlock Text="Partitions to keep" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding PartitionChoices}" SelectedItem="{Binding Partitions}" />

                <TextBlock Text="File splitting" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding SplitChoices}" SelectedItem="{Binding Split}" />

                <TextBlock Text="Folder names" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding TitleChoices}" SelectedItem="{Binding FolderNaming}" />

                <TextBlock Text="Cover art" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding CoverChoices}" SelectedItem="{Binding CoverLoader}" />
                <CheckBox Content="Download cover art for each game after it has been copied"
                          IsChecked="{Binding DownloadCoversAfterTransfer}" Margin="0,4,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Loader drive (optional)" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding CoverRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCoverRootCommand}" Margin="8,0,0,0" />
                </Grid>
                <CheckBox Content="Show each game's cover in the game lists (these are kept on this PC)"
                          IsChecked="{Binding ShowCoverArt}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource FieldHint}">
                    Covers come from <Hyperlink NavigateUri="https://www.gametdb.com" RequestNavigate="OnOpenLink">GameTDB</Hyperlink>,
                    where anyone can add one that is missing. Leave the loader drive empty unless the loader is on a different
                    drive from the games.
                </TextBlock>

                <TextBlock Text="Checks and speed" Style="{StaticResource FieldLabel}" />
                <CheckBox Content="Read each game back from the target after writing and compare it (takes about as long again)"
                          IsChecked="{Binding VerifyAfterWrite}" />
                <CheckBox Content="Have NKit re-read each rebuilt ISO from disk as well (slower)"
                          IsChecked="{Binding NKitFullVerify}" />
                <CheckBox Content="Prepare the next game while the current one is being written (faster, uses more work space)"
                          IsChecked="{Binding PrepareAhead}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
