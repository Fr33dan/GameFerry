<Window x:Class="GameFerry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameFerry.App"
        xmlns:vm="clr-namespace:GameFerry.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GameFerry"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Activated="OnActivated" Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ByteSizeConverter x:Key="ByteSize" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Source rows that can't be picked (already on the target, or not a Wii disc) are dimmed. -->
        <Style x:Key="SourceTextCell" TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
            <Setter Property="ToolTip" Value="{Binding FileName}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanTransfer}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OnTarget}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SourceNumberCell" TargetType="TextBlock" BasedOn="{StaticResource SourceTextCell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Status messages can be longer than the column, so the full text is the tooltip. -->
        <Style x:Key="SourceStatusCell" TargetType="TextBlock" BasedOn="{StaticResource SourceTextCell}">
            <Setter Property="ToolTip" Value="{Binding StatusText}" />
        </Style>

        <!-- A game's front cover at the size of a row. Hovering over it shows it full size; that picture
             is filled in by OnCoverToolTipOpening. Until the cover has been fetched there is an empty frame. -->
        <DataTemplate x:Key="CoverThumbnail" DataType="{x:Type vm:CoverImage}">
            <Border x:Name="Frame" Width="30" Height="42" CornerRadius="2" Background="#24808080"
                    ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000"
                    ToolTipOpening="OnCoverToolTipOpening">
                <Border.ToolTip>
                    <ToolTip Placement="Right" HorizontalOffset="8" Padding="6">
                        <Image Width="160" Height="224" RenderOptions.BitmapScalingMode="HighQuality" />
                    </ToolTip>
                </Border.ToolTip>
                <Image Source="{Binding Thumbnail}" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,30,42" RadiusX="2" RadiusY="2" />
                    </Image.Clip>
                </Image>
            </Border>
            <DataTemplate.Triggers>
                <!-- A file that isn't a game has no cover, and no empty frame either. -->
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter TargetName="Frame" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The cover in front of a game's title. With covers switched off it takes up no room. -->
        <Style x:Key="CoverCell" TargetType="ContentPresenter">
            <Setter Property="ContentTemplate" Value="{StaticResource CoverThumbnail}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Visibility"
                    Value="{Binding DataContext.ShowCovers, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <!-- Dimmed along with the text of a source row that can't be picked. -->
        <Style x:Key="SourceCoverCell" TargetType="ContentPresenter" BasedOn="{StaticResource CoverCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanTransfer}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OnTarget}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- Sources on the left, target on the right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="520" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Source games -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="{StaticResource PanelGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Games" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Folder containing your games (7z, zip, rar, nkit.iso, iso, wbfs)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RefreshSourcesCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="Rescan" Command="{Binding RefreshSourcesCommand}" Margin="8,0,0,0" />
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="{StaticResource PanelGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search by title, file name or game ID" IsHitTestVisible="False" Margin="12,0"
                                   VerticalAlignment="Center" Opacity="0.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox Grid.Column="1" Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                              VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Grid.Column="2" Content="Select all" Command="{Binding SelectAllCommand}" Margin="12,0,0,0"
                            ToolTip="Tick every listed game that is not on the target yet" />
                    <Button Grid.Column="3" Content="Clear" Command="{Binding SelectNoneCommand}" Margin="8,0,0,0" />
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SelectionSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectionSummary}" />
                    <TextBlock Grid.Column="1" Text="Reading game headers…" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Grid.Column="2" Content="Show other files" IsChecked="{Binding ShowOtherFiles}" VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="Also list files that can't be copied (WiiWare, GameCube, unreadable), with the reason" />
                </Grid>

                <DataGrid x:Name="SourceGrid" ItemsSource="{Binding SourcesView}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                          IsReadOnly="True" RowHeight="{Binding GameRowHeight}" PreviewKeyDown="OnSourceGridKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False" SortMemberPath="IsSelected">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanTransfer}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Margin="10,0,0,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Title" Width="3*" MinWidth="180" SortMemberPath="Title"
                                                ClipboardContentBinding="{Binding Title}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding Cover}" Style="{StaticResource SourceCoverCell}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SourceTextCell}" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource SourceTextCell}" />
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="118" ElementStyle="{StaticResource SourceTextCell}" />
                        <DataGridTextColumn Header="File size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="88" ElementStyle="{StaticResource SourceNumberCell}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" MinWidth="130" ElementStyle="{StaticResource SourceStatusCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Target -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="{StaticResource PanelGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Copy to" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                              IsEnabled="{Binding IsIdle}" ToolTip="SD card or USB drive to copy games to" />
                    <Button Grid.Column="2" Content="Folder…" Command="{Binding BrowseTargetCommand}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0"
                            ToolTip="Use a folder in place of a drive: games go in its wbfs folder, just as they would on the drive" />
                    <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshTargetCommand}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0" />
                </Grid>

                <StackPanel DockPanel.Dock="Top" Margin="{StaticResource PanelGap}">
                    <TextBlock Text="{Binding TargetInfo}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetInfo}" />
                    <ProgressBar Value="{Binding TargetUsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,4"
                                 ToolTip="Space used on the target" />
                    <TextBlock Text="{Binding TargetSpaceText}" Style="{StaticResource Hint}" />
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Download covers" Command="{Binding DownloadCoversCommand}"
                                ToolTip="Download missing cover art from GameTDB for every game on the target, into the loader's cover folders" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,8,0"
                                   ToolTip="Where the covers come from. Anyone can add one that is missing.">
                            from <Hyperlink NavigateUri="https://www.gametdb.com" RequestNavigate="OnOpenLink">GameTDB</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Delete…" Command="{Binding DeleteTargetGameCommand}"
                            ToolTip="Delete the selected game from the target" />
                    <Button Grid.Column="2" Content="Settings…" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0" />
                </Grid>

                <DataGrid ItemsSource="{Binding TargetGames}" SelectedItem="{Binding SelectedTargetGame}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          IsReadOnly="True" RowHeight="{Binding GameRowHeight}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On target" Width="*" MinWidth="140" SortMemberPath="Title"
                                                ClipboardContentBinding="{Binding Title}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding Cover}" Style="{StaticResource CoverCell}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextCell}" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id6}" Width="86" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource ByteSize}}" SortMemberPath="Size" Width="96"
                                            ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- Transfer -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Copy selected games" Command="{Binding StartTransferCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Padding="18,8" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelTransferCommand}" Padding="18,8" Margin="8,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Hint}" Margin="12,0,0,0" />
                </Grid>
                <ProgressBar Value="{Binding StagePercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,6,0,4"
                             ToolTip="Current step of the current game" />
                <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" Height="6"
                             ToolTip="All selected games" />
            </StackPanel>
        </Grid>

        <!-- Log -->
        <TextBox Grid.Row="2" x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12.5" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextChanged="OnLogChanged" />
    </Grid>
</Window>
