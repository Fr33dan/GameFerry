<?xml version="1.0" encoding="utf-8"?>
<!--
  One portable executable: the .NET runtime and every library are inside it, so it runs on any 64-bit
  Windows 10/11 without installing anything.

    dotnet publish src\GameFerry.Cli -p:PublishProfile=Portable

  Add -p:SelfContained=false for a much smaller file that needs the .NET 10 Runtime to be installed.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' != 'false'">true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
